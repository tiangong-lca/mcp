{
  "name": "@tiangong-lca/mcp-server",
  "version": "0.2.1",
  "description": "TianGong LCA MCP Server",
  "license": "MIT",
  "author": "Nan LI",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiangong-lca/mcp"
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "bin": {
    "tiangong-lca-mcp-stdio": "dist/src/index.js",
    "tiangong-lca-mcp-http": "dist/src/index_server.js",
    "tiangong-lca-mcp-http-local": "dist/src/index_server_local.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:clean": "node ./scripts/build.mjs --clean",
    "typecheck": "pnpm exec tsc --noEmit",
    "start": "pnpm build && node ./scripts/start-dev.mjs stdio",
    "start:server": "pnpm build && node ./scripts/start-dev.mjs http",
    "start:server-local": "pnpm build && node ./scripts/start-dev.mjs http-local",
    "test": "node ./scripts/run-tests.mjs",
    "test:consumer": "node ./scripts/test-packed-consumer.mjs",
    "test:clean-worktree": "node ./scripts/test-clean-worktree.mjs",
    "test:toolchain": "node --test test/toolchain-contract.test.mjs",
    "test:pack": "pnpm --filter @tiangong-lca/mcp-server --fail-if-no-match pack --dry-run",
    "audit": "pnpm audit --audit-level high",
    "peers:check": "pnpm peers check",
    "lint": "pnpm lint:oxlint && pnpm lint:prettier && pnpm typecheck",
    "lint:oxlint": "pnpm exec oxlint --type-aware --format=stylish --deny-warnings ./src ./test ./scripts",
    "lint:prettier": "pnpm exec prettier --check \"{src,test,docs,scripts}/**/*.{js,cjs,mjs,jsx,tsx,ts,md,json}\" \"*.{js,cjs,mjs,jsx,tsx,ts,md,json}\"",
    "format": "pnpm exec prettier --write \"{src,test,docs,scripts}/**/*.{js,cjs,mjs,jsx,tsx,ts,md,json}\" \"*.{js,cjs,mjs,jsx,tsx,ts,md,json}\"",
    "prepush:gate": "pnpm lint && pnpm peers:check && pnpm test && pnpm test:consumer && pnpm build && pnpm test:toolchain && pnpm run audit && pnpm test:pack && pnpm test:clean-worktree",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm prepush:gate"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.24.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supabase/supabase-js": "2.112.4",
    "@tiangong-lca/tidas-sdk": "0.2.0",
    "express": "5.2.1",
    "olca-ipc": "2.6.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
